<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Orbot: to find it and ask it to start, for routing through Tor. -->
    <queries>
        <package android:name="org.torproject.android" />
        <!-- Tor Browser: external links open there while Tor is on. -->
        <package android:name="org.torproject.torbrowser" />
        <package android:name="org.torproject.torbrowser_alpha" />
        <!-- App stores (F-Droid, Droid-ify, Aurora, Play...) that can show Orbot's page. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
    </queries>

    <!-- No system backup or device transfer: the vault leaves the phone only as the backup the
         user makes from the settings, to a place of their choosing. -->
    <application
        android:name=".BooruVaultApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.BooruVault">

        <!-- The app has no WebView: its browsers run on GeckoView. It asks the system's WebView
             for Chrome's version alone, and that sends no usage statistics and checks nothing
             with Google. -->
        <meta-data
            android:name="android.webkit.WebView.MetricsOptOut"
            android:value="true" />
        <meta-data
            android:name="android.webkit.WebView.EnableSafeBrowsing"
            android:value="false" />

        <!-- Compose lays itself out again on these changes; recreating the activity instead
             would throw away the built-in browser's page, a picker's purpose and the dialogs. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.BooruVault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".download.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Keeps the app alive while a backup of the vault is written or brought back. -->
        <service
            android:name=".vault.BackupService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- The timed auto-lock's alarm, sent only by the system on the app's behalf. -->
        <receiver
            android:name=".vault.AutoLockReceiver"
            android:exported="false" />
    </application>
</manifest>
